# Shuttle Secrets Configuration (Local Development)
# Copy this file to Secrets.toml and fill in your values
# IMPORTANT: Never commit Secrets.toml to git!

# Required - API Authentication
KAIBA_API_KEY = "your-api-key-here"

# MemoryKai (Qdrant) - Vector search
QDRANT_URL = "https://your-cluster.qdrant.io:6333"
QDRANT_API_KEY = "your-qdrant-api-key"

# GraphKai (Neo4j) - Knowledge graph
# Get free tier at: https://neo4j.com/cloud/aura-free/
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "your-neo4j-password"

# Embedding Service (OpenAI)
OPENAI_API_KEY = "sk-your-openai-key"

# Web Search Agent (Google Gemini)
GEMINI_API_KEY = "your-gemini-api-key"

# Decision Engine (Groq - optional, falls back to rule-based)
# Get free API key at: https://console.groq.com/
# GROQ_API_KEY = "gsk_your-groq-api-key"

# Optional - Autonomous Learning
# LEARNING_INTERVAL_SECS = "3600"
