# Kaiba Server - Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ============================================================
# Required
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/kaiba

# ============================================================
# Server
# ============================================================

# Listen port (default: 8080, Cloud Run sets this automatically)
# PORT=8080

# Log level (default: kaiba_server=info,tower_http=info)
# RUST_LOG=kaiba_server=debug,tower_http=debug

# ============================================================
# Authentication
# ============================================================

# API key for bearer auth (optional, auth disabled if unset)
# KAIBA_API_KEY=your-api-key

# ============================================================
# MemoryKai (Qdrant) - Vector Search
# ============================================================

# QDRANT_URL=https://xxx.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-key

# ============================================================
# Embedding (OpenAI) - text-embedding-3-small
# ============================================================

# OPENAI_API_KEY=sk-xxx

# ============================================================
# WebSearch (Gemini Grounded Search)
# ============================================================

# GEMINI_API_KEY=your-gemini-key

# ============================================================
# GraphKai (Neo4j) - Knowledge Graph
# ============================================================

# NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# ============================================================
# Decision Engine (Groq) - LLM-based decisions
# ============================================================

# GROQ_API_KEY=gsk_xxx

# ============================================================
# Scheduler
# ============================================================

# Autonomous learning interval in seconds (default: 3600)
# LEARNING_INTERVAL_SECS=3600
